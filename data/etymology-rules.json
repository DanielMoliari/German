  {
    "id": "rule-d-to-t",
    "title": "English 'd' → German 't'",
    "description": "High German consonant shift: the Germanic voiced stop 'd' stayed 'd' in English but shifted to unvoiced 't' in German. Say the English word and swap the 'd' for a 't' to guess the German one.",
    "type": "sound-shift",
    "examples": [
      { "german": "hart", "english": "hard", "highlight": { "german": [3], "english": [3] } },
      { "german": "Tag", "english": "day", "highlight": { "german": [0], "english": [0] } },
      { "german": "tun", "english": "do", "highlight": { "german": [0], "english": [0] } },
      { "german": "tot", "english": "dead", "highlight": { "german": [0, 2], "english": [0, 3] } },
      { "german": "Tat", "english": "deed", "highlight": { "german": [0], "english": [0] } },
      { "german": "Tochter", "english": "daughter", "highlight": { "german": [0], "english": [0] } },
      { "german": "trinken", "english": "drinking", "highlight": { "german": [0], "english": [0] } }
    ]
  },
